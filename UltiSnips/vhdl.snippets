extends vhdl

global !p
def vhdl_fsm(snip):
    import math

    states = snip.buffer[snip.line].strip().split(",")
    states = [s.strip().upper() for s in states]
    snip.buffer[snip.line] = ""

    lines = []

    # Enumeration type declaration
    state_list = ", ".join(states)
    lines.append(f"\ttype ${{1:state}}_t is ({state_list});")
    lines.append(f"\tsignal $1_reg, $1_next : $1_t;")
    lines.append(f"")

    # Clocked register process
    lines.append(f"\t-- State register")
    lines.append(f"\tprocess(${{2:clk}}) begin")
    lines.append(f"\t\tif rising_edge($2) then")
    lines.append(f"\t\t\tif (${{3:rst}} = '1') then")
    lines.append(f"\t\t\t\t$1_reg <= ${{4:{states[0]}}};")
    lines.append(f"\t\t\telse")
    lines.append(f"\t\t\t\t$1_reg <= $1_next;")
    lines.append(f"\t\t\tend if;")
    lines.append(f"\t\tend if;")
    lines.append(f"\tend process;")
    lines.append(f"")

    # Combinational next-state process
    lines.append(f"\t-- Next-state logic")
    lines.append(f"\tprocess(all) begin")
    lines.append(f"\t\t${{5:-- Default combinational values}}")
    lines.append(f"\t\t$1_next <= $1_reg;")
    lines.append(f"")
    lines.append(f"\t\tcase $1_reg is")
    for i, s in enumerate(states):
        lines.append(f"\t\t\twhen {s} =>")
        next_s = states[(i + 1) % len(states)]
        lines.append(f"\t\t\t\t$1_next <= {next_s};")
        lines.append(f"")
    lines.append(f"\t\t\twhen others =>")
    lines.append(f"\t\t\t\t$1_next <= ${{6:{states[0]}}};")
    lines.append(f"")
    lines.append(f"\t\tend case;")
    lines.append(f"\tend process;")

    snip.expand_anon("\n".join(lines))


def resolve_entity_signature(entity_name, trigger_prefix):
    import json
    import vim

    from hdl_signature import parse_file

    # ctags is configured with --fields=+K (long kind names), so the tag's
    # kind is the string "entity", not the short letter "e".
    tags = [
        t for t in vim.eval("taglist('^%s$')" % entity_name)
        if t.get("kind") == "entity"
    ]
    if not tags:
        vim.command(
            "echohl ErrorMsg | echo %s | echohl None"
            % json.dumps("%s: no entity '%s' found in tags" % (trigger_prefix, entity_name))
        )
        return None

    # taglist() already resolves 'filename' against the tags file's own
    # directory (Vim's default 'tagrelative' behaviour), which matters here
    # because gutentags stores the tags file under ~/.cache, not the project
    # root; fnamemodify(...,':p') just normalizes relative-to-cwd cases too.
    files = sorted({t["filename"] for t in tags})
    if len(files) > 1:
        prompt = ['Multiple declarations of entity "%s":' % entity_name]
        prompt += ["%d. %s" % (i, f) for i, f in enumerate(files, 1)]
        choice = int(vim.eval("inputlist(%s)" % json.dumps(prompt)))
        if choice < 1 or choice > len(files):
            return None
        chosen_file = files[choice - 1]
    else:
        chosen_file = files[0]
    chosen_file = vim.eval("fnamemodify(%s, ':p')" % json.dumps(chosen_file))

    signatures = [s for s in parse_file(chosen_file) if s.name == entity_name]
    if not signatures:
        vim.command(
            "echohl ErrorMsg | echo %s | echohl None"
            % json.dumps(
                "%s: entity '%s' not found while parsing %s"
                % (trigger_prefix, entity_name, chosen_file)
            )
        )
        return None
    return signatures[0]


def vhdl_instantiate(snip):
    import re
    import vim

    from hdl_signature import render_instantiation

    # `match` (from the triggering snippet's `!p snip.rv = match.group(0)`) is
    # only available to that inline interpolation, not to this post_jump
    # callback, so the same trigger regex is re-run against the buffer line —
    # mirroring vhdl_fsm's raw-text-roundtrip technique above, but slicing on
    # match.start() rather than clearing the whole line so indentation already
    # on the line (e.g. inside an architecture body) survives.
    line = snip.buffer[snip.line]
    m = re.search(r"inst:(\w+)(?::([pta]*))?", line)
    if not m:
        return
    entity_name, opts = m.group(1), m.group(2)
    if opts is None:
        # No `:options` suffix at all -> vimrc-configurable default; an
        # explicit (even empty) suffix always overrides it completely.
        opts = vim.eval("get(g:, 'vhdl_instantiation_default_style', 'pa')")
    style = set(opts) & {"p", "t", "a"}

    snip.buffer[snip.line] = line[: m.start()]
    # UltiSnips requires any action that edits the line under the cursor to
    # also set snip.cursor explicitly — otherwise it can't tell where the
    # cursor belongs afterward and raises a PebkacError, even on an early
    # return below where expand_anon (which sets it as a side effect) is
    # never reached.
    snip.cursor.set(snip.line, m.start())

    signature = resolve_entity_signature(entity_name, "inst")
    if signature is None:
        return

    body = render_instantiation(
        signature,
        prefill="p" in style,
        tabstop="t" in style,
        align="a" in style,
    )
    snip.expand_anon(body)


def vhdl_component_decl(snip):
    import re

    from hdl_signature import render_declaration

    # Mirrors vhdl_instantiate's trigger-matching/line-slicing technique
    # above. render_declaration's output has no tabstop markup, but
    # expand_anon handles a plain-text body correctly regardless — it
    # still applies the current line's indentation to every continuation
    # line and leaves the cursor at the implicit end, exactly as it would
    # for an explicit $0 (confirmed empirically, not just assumed).
    line = snip.buffer[snip.line]
    m = re.search(r"comp:(\w+)", line)
    if not m:
        return
    entity_name = m.group(1)

    snip.buffer[snip.line] = line[: m.start()]
    snip.cursor.set(snip.line, m.start())

    signature = resolve_entity_signature(entity_name, "comp")
    if signature is None:
        return

    body = render_declaration(signature, keyword="component")
    snip.expand_anon(body)
endglobal

post_jump "vhdl_fsm(snip)"
snippet "fsm\s+(((\w+),)*\w+)" "Finite state machine" br
`!p snip.rv = match.group(1) `$0
endsnippet

# Native UltiSnips format (rather than snipmate) is deliberate: it defaults to
# priority 0, which beats the fixed priority -1000 that UltiSnips assigns to
# every snipmate-format snippet — including honza/vim-snippets' shipped
# vhdl.snippets. Without that priority gap, every trigger shared between the
# two files (lib, libs, libx, ent, pr, prc, prcr, pra, if, ife, el, eif, ca,
# wh, for, oth) pops up an ambiguous-match menu instead of expanding directly.
priority 1

snippet lib "Use a user-defined library"
library ${1}
use $1.${2}
endsnippet

snippet libs "Use standard IEEE libraries"
library IEEE;
use IEEE.std_logic_1164.all;
use IEEE.numeric_std.all;
endsnippet

snippet libx "Use Xilinx libraries"
library UNISIM;
use UNISIM.vcomponents.all;
endsnippet

snippet ent "Entity"
entity ${1:`vim_snippets#Filename()`} is
	generic (
		${2:generics}
	);
	port (
		${3:ports}
	);
end entity $1;
endsnippet

snippet pac "Package declaration"
 package ${1:`vim_snippets#Filename()`} is
	generic (
		${2:generics}
	);
	${3:package content}
end package $1;
endsnippet

snippet arc "Architecture"
architecture ${1:behav} of ${2:`vim_snippets#Filename()`} is
	${3:-- architecture declaration}
begin
	${4:-- architecture logic}
end architecture $1;
endsnippet

snippet comp "Component declaration"
component ${1:name} is
	generic (
		${2:generics}
	);
	port (
		${3:ports}
	);
end component $1;
endsnippet

snippet inst "Component instantiation"
${1:inst_name} : ${2:component_name}
	generic map (
		${3:generics}
	)
	port map (
		${4:ports}
	);
endsnippet

snippet inste "Direct entity instantiation"
${1:inst_name} : entity ${2:work}.${3:entity_name}
	generic map (
		${4:generics}
	)
	port map (
		${5:ports}
	);
endsnippet

post_jump "vhdl_instantiate(snip)"
snippet "inst:(\w+)(?::([pta]*))?" "Entity instantiation from hdl-signature (ctags-resolved)" br
`!p snip.rv = match.group(0)`$0
endsnippet

post_jump "vhdl_component_decl(snip)"
snippet "comp:(\w+)" "Component declaration from hdl-signature (ctags-resolved)" br
`!p snip.rv = match.group(0)`$0
endsnippet

snippet fun "Function declaration"
function ${1:name} (
	${2:function_parameters}
) return ${3:return_type} is
	${4:variable_declarations}
begin
	${0:${VISUAL}}
end function $1;
endsnippet

snippet ifgen "If Generate"
${1:GEN_LABEL} : if ${2:CONDITION} generate
	${3:${VISUAL}}
begin
	${4:${VISUAL}}
end generate $1;
endsnippet

snippet forgen "For Generate"
${1:GEN_LABEL} : for ${2:i} in ${3:0} to ${4:N} - 1 generate
	${5:${VISUAL}}
end generate $1;
endsnippet

snippet whe "Conditional (when...else) chain link"
${1:value} when ${2:condition} else $0
endsnippet

## Declarations
snippet co "Constant"
constant C_${1:CONSTANT_NAME} : ${2:integer} := ${3:value};
endsnippet

snippet sl "std_logic"
std_logic
endsnippet

snippet slv "std_logic_vector"
std_logic_vector(${1:n} downto ${2:0})
endsnippet

snippet ge "Generic-like format, name : type"
${1:NAME} : ${2:std_logic};
endsnippet

snippet si "Signal declaration"
signal ${1:signal_name} : ${2:std_logic};
endsnippet

snippet var "Variable declaration"
variable ${1:name} : ${2:integer};
endsnippet

snippet io "Input/output declaration"
${1:name} : ${2: in} ${3:std_logic};
endsnippet

## Process Statements
snippet pr "Bare process"
process (${1:sensitivity list})
begin
	${2:${VISUAL}}
end process;
endsnippet

snippet prc "Process with clock"
process (${1:clk})
begin
	if rising_edge ($1) then
		${2:${VISUAL}}
	end if;
end process;
endsnippet

snippet prcr "Process with clock and reset"
process (${1:clk}, ${2:nrst})
begin
	if ($2 = '${3:0}') then
		${4:${VISUAL}}
	elsif rising_edge($1) then
		${5:${VISUAL}}
	end if;
end process;
endsnippet

snippet prcs "Process with clock and synchronous reset"
process (${1:clk})
begin
	if rising_edge($1) then
		if (${2:rst_n} = '${3:0}') then
			${4:${VISUAL}}
		else
			${5:${VISUAL}}
		end if;
	end if;
end process;
endsnippet

snippet pra "Process all"
process (${1:all})
begin
	${2:${VISUAL}}
end process;
endsnippet

## Control Statements
snippet if "If statement"
if ${1} then
	${2:${VISUAL}}
end if;
endsnippet

snippet ife "If-else statement"
if ${1} then
	${2:${VISUAL}}
else
	${3:${VISUAL}}
end if;
endsnippet

snippet el "Else statement"
else
	${1:${VISUAL}}
endsnippet

snippet eif "Elsif statement"
elsif ${1} then
	${2:${VISUAL}}
endsnippet

snippet ca "Case statement"
case ${1} is
	${2:${VISUAL}}
end case;
endsnippet

snippet wh "When statement"
when ${1} =>
	${2:${VISUAL}}
endsnippet

snippet for "For loop"
for ${1:i} in ${2} ${3:to} ${4} loop
	${5:${VISUAL}}
end loop;
endsnippet

snippet whi "While loop"
while ${1} loop
	${2:${VISUAL}}
end loop;
endsnippet

## Misc
snippet oth "Others"
(others => '${1:0}');
endsnippet
